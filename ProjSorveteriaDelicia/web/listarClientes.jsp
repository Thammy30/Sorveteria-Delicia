<%@page contentType="text/html" pageEncoding="UTF-8"%>
<!DOCTYPE html>
<html>
    <head>
        <meta http-equiv="Content-Type" content="text/html; charset=UTF-8">
        <title>JSP Page - Sorveteria</title>
        <style>
            body {
                background: linear-gradient(to bottom, #ffe6f0, #fff5e6); /* Fundo suave de sorvete */
                font-family: 'Comic Sans MS', cursive, sans-serif;
                text-align: center;
                padding: 50px;
            }

            h1 {
                color: #ff66b2; /* Rosa vibrante */
                font-size: 3em;
                text-shadow: 2px 2px #fff;
            }

            a {
                display: inline-block;
                padding: 15px 30px;
                margin-top: 20px;
                background: #ffcc66; /* cor de casquinha */
                color: #fff;
                text-decoration: none;
                font-weight: bold;
                border-radius: 25px;
                box-shadow: 2px 2px 5px #aaa;
                transition: all 0.3s ease;
            }

            a:hover {
                background: #ff99cc; /* cor de sorvete de morango */
                transform: scale(1.1);
            }

            /* Pequenas decorações de sorvete */
            .ice-cream {
                width: 100px;
                margin: 20px auto;
            }
        </style>
    </head>
    <body>
        <h1>Cadastro excluído com Sucesso!!</h1>
        <a href="index.html">Voltar</a>
    </body>
</html>
